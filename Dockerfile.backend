# ============================================================================
# Dockerfile.backend
# Lance le backend FastAPI depuis back/
# ============================================================================
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    libgdal-dev libgeos-dev libproj-dev gcc curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY back/ ./back/

EXPOSE 8000

CMD ["uvicorn", "back.backend:app", "--host", "0.0.0.0", "--port", "8000"]
