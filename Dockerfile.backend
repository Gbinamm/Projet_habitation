# ============================================================================
# Dockerfile.backend
# Lance le backend FastAPI depuis back/
# ============================================================================
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    libgdal-dev libgeos-dev libproj-dev gcc curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY back/ ./back/

EXPOSE 8000

# On se place dans back/ pour que les imports relatifs fonctionnent
# (backend.py fait "from agent import chat" — agent.py est dans back/)
CMD ["sh", "-c", "cd /app/back && uvicorn backend:app --host 0.0.0.0 --port 8000"]
