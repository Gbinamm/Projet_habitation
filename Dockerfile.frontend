# ============================================================================
# Dockerfile.frontend
# Build React (Vite) puis sert via nginx
# ============================================================================

# Stage 1 — build
FROM node:20-alpine AS builder
WORKDIR /app
COPY front-react/package*.json ./
RUN npm ci
COPY front-react/ .
RUN npm run build

# Stage 2 — serve
FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html

# Config nginx pour React Router (SPA)
RUN printf 'server {\n\
  listen 80;\n\
  location / {\n\
    root /usr/share/nginx/html;\n\
    index index.html;\n\
    try_files $uri $uri/ /index.html;\n\
  }\n\
}\n' > /etc/nginx/conf.d/default.conf

EXPOSE 80
